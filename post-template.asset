<div class="cursor" id="cur"></div>
<div class="cursor-ring" id="cur-ring"></div>

<script src="/js/data.js?v=20261108"></script>
<script src="/js/conversion.js?v=20261108"></script>
<script>
(function(){
    const cur=document.getElementById('cur'),ring=document.getElementById('cur-ring');
    let mx=0,my=0,rx=0,ry=0;
    window.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
    (function follow(){rx+=(mx-rx)*.1;ry+=(my-ry)*.1;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(follow);})();
    window.addEventListener('scroll',()=>document.getElementById('nav').classList.toggle('scrolled',window.scrollY>64),{passive:true});
    const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}}),{threshold:.08});
    document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
    document.addEventListener('mouseover',e=>{
        if(e.target.closest('a,button,summary')){cur.classList.add('active');ring.classList.add('active');}
        else{cur.classList.remove('active');ring.classList.remove('active');}
    });
})();
</script>
