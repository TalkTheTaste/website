# Required for admin access; generate your own independent values.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional Node runtime data directory and trusted TLS proxy.
DATA_DIR=
TRUST_PROXY=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_USER=
ONEDRIVE_CLIENTS_PATH=TalkTheTaste/Work Portfolio/Clients

# Custom consultation booking. The BOOKINGS_* values can use a separate Entra app;
# when omitted, the existing MS_* Graph application is used. Keep secrets server-side.
BOOKINGS_TENANT_ID=
BOOKINGS_CLIENT_ID=
BOOKINGS_CLIENT_SECRET=
BOOKING_BUSINESS_ID=BookaMeetingwithUs@talkthetaste.com
BOOKING_SERVICE_NAME=Free Marketing Consultation
# Optional: pin a service by its Microsoft GUID instead of its exact name.
BOOKING_SERVICE_ID=
# Verify this against the business working hours in Microsoft Bookings.
BOOKING_BUSINESS_TIME_ZONE=Asia/Riyadh
# Optional dedicated 32+ character signing secret; otherwise SESSION_SECRET is used.
BOOKING_SIGNING_SECRET=
